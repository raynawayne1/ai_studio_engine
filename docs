python3 -c "
import os

for filename in ['selfie_segmentation.onnx', 'faceswap.onnx', 'body_tracker.onnx']:
    if os.path.exists(filename):
        with open(filename, 'rb') as f:
            content = f.read()
        
        # Protobuf binary tag for ir_version = 10 is b'\x08\x0a'
        # We patch it to b'\x08\x09' (ir_version = 9)
        if b'\x08\x0a' in content:
            new_content = content.replace(b'\x08\x0a', b'\x08\x09', 1)
            with open(filename, 'wb') as f:
                f.write(new_content)
            print(f'✅ Successfully byte-patched {filename} IR version from 10 to 9!')
        else:
            print(f'⚡ {filename} already patched or uses a different header.')
