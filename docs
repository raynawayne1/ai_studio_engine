}

for name, url in models.items():
    if not os.path.exists(name) or os.path.getsize(name) < 1024 * 1024:
        print(f"⏳ Downloading {name} (production weights)...")
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
